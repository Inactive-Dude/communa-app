# ============================================================
# .env.example — Environment Variable Template for Communa
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git (it's in .gitignore).
#
#   cp .env.example .env
# ============================================================

# ─── Spring Profile ──────────────────────────────────────────
# Options: dev | prod
SPRING_PROFILES_ACTIVE=dev

# ─── Database ────────────────────────────────────────────────
# MySQL root password
DB_PASSWORD=pass

# ─── Email ───────────────────────────────────────────────────
# Gmail App Password — generate at:
#   https://myaccount.google.com/apppasswords
# (Requires 2FA to be enabled on your Google account)
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ─── JWT ─────────────────────────────────────────────────────
# Minimum 64 characters. Generate one with:
#   openssl rand -base64 64
JWT_SECRET=YourVeryLongAndSecureSecretKeyForCommunaApp_MustBeAtLeast256BitsLongForHS256

# ─── Admin ───────────────────────────────────────────────────
# Secret header required when calling POST /api/admin/create
# Choose any hard-to-guess string
ADMIN_CREATE_SECRET=change-me-before-creating-admins

# ─── Frontend URL ─────────────────────────────────────────────
# Used in email links. Change to your real domain in production.
# dev:  http://localhost:8082
# prod: https://communa.yourdomain.com
FRONTEND_URL=http://localhost:8082

# ─── Server ──────────────────────────────────────────────────
# Port the app listens on (default 8082)
SERVER_PORT=8082
